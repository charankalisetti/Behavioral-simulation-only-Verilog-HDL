 module bell_triangle;
 integer n=5;
 integer bell[9:0][9:0];
 
 initial 
	begin:block
		integer r,c;
		bell[0][0]=1;
		$display("%0d",bell[0][0]);
		
		for(r=1;r<=n;r=r+1)
			begin
				bell[r][0]=bell[r-1][r-1];
				$display(" ");
				$write("%0d",bell[r][0]);
				for(c=1;c<=r;c=c+1)
					begin
						bell[r][c]=bell[r][c-1]+bell[r-1][c-1];
						$write("%0d",bell[r][c]);
					end
			end	
 end	
endmodule